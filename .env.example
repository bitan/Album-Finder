# Copy this file to .env and fill in your real values.
# Never commit .env to source control.

# A long random secret string used to sign JWTs (minimum 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-random-64-char-hex-secret-here

# --- LOCAL DEVELOPMENT ---
# Path to your Firebase service account key JSON file.
# Download from Firebase Console > Project Settings > Service Accounts
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# --- PRODUCTION / CLOUD DEPLOY ---
# Instead of a file path, paste the entire service account JSON as a single-line string.
# This is how Railway, Render, Fly.io etc handle secrets.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
